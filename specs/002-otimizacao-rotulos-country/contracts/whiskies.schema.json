{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MoraesNico/gondola/specs/002-otimizacao-rotulos-country/contracts/whiskies.schema.json",
  "title": "Catálogo da gôndola de whisky (v2: garrafa estendida e rótulo por estilo)",
  "type": "object",
  "required": [
    "expositor",
    "produtos"
  ],
  "properties": {
    "expositor": {
      "type": "object",
      "required": [
        "nome",
        "categoria"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "categoria": {
          "type": "string",
          "minLength": 1
        },
        "moeda": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "BRL"
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "produtos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/produto"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "produto": {
      "type": "object",
      "required": [
        "id",
        "nome",
        "descricao",
        "preco",
        "teorAlcoolico",
        "disponivel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "ordem": {
          "type": "integer",
          "minimum": 1
        },
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "marca": {
          "type": "string"
        },
        "tipo": {
          "type": "string"
        },
        "pais": {
          "type": "string"
        },
        "regiao": {
          "type": "string"
        },
        "idade": {
          "type": "string"
        },
        "volumeMl": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "teorAlcoolico": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "preco": {
          "type": "number",
          "minimum": 0
        },
        "descricao": {
          "type": "string",
          "minLength": 1
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "harmonizacao": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disponivel": {
          "type": "boolean",
          "description": "false = produto em falta; não ocupa prateleira"
        },
        "garrafa": {
          "type": "object",
          "properties": {
            "formato": {
              "enum": [
                "redonda",
                "quadrada",
                "frasco",
                "facetada"
              ]
            },
            "altura": {
              "type": "number",
              "minimum": 0.18,
              "maximum": 0.36
            },
            "largura": {
              "type": "number",
              "minimum": 0.06,
              "maximum": 0.12
            },
            "profundidade": {
              "type": "number",
              "minimum": 0.03,
              "maximum": 0.12
            },
            "ombro": {
              "description": "enum legado ou [início, fim] da curva do ombro (fração da altura)",
              "oneOf": [
                {
                  "enum": [
                    "alto",
                    "medio",
                    "baixo"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0.4,
                    "maximum": 0.9
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            },
            "raioGargalo": {
              "type": "number",
              "minimum": 0.009,
              "maximum": 0.025
            },
            "fundo": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 0.12,
              "description": "espessura do fundo de vidro (fração da altura)"
            },
            "tampa": {
              "enum": [
                "capsula",
                "rolha-vidro"
              ]
            },
            "capsula": {
              "type": "object",
              "properties": {
                "inicio": {
                  "type": "number",
                  "minimum": 0.6,
                  "maximum": 0.95
                },
                "cor": {
                  "$ref": "#/$defs/hex"
                },
                "metalica": {
                  "type": "boolean"
                }
              }
            },
            "corVidro": {
              "$ref": "#/$defs/hex"
            },
            "corLiquido": {
              "$ref": "#/$defs/hex"
            },
            "corRotulo": {
              "$ref": "#/$defs/hex",
              "description": "usado só pelo estilo genérico"
            },
            "corTextoRotulo": {
              "$ref": "#/$defs/hex",
              "description": "usado só pelo estilo genérico"
            }
          }
        },
        "rotulo": {
          "type": "object",
          "properties": {
            "estilo": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "template de src/scene/labelArt.js; desconhecido → generico",
              "examples": [
                "buffalo-trace",
                "woodford-reserve",
                "jack-daniels",
                "jameson",
                "chivas-regal",
                "johnnie-walker-black",
                "ballantines",
                "macallan",
                "glenlivet-caribbean",
                "hibiki",
                "generico"
              ]
            },
            "destaque": {
              "$ref": "#/$defs/hex",
              "description": "cor da marca na interface"
            },
            "textos": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "textos que sobrescrevem o template (ex.: nome)"
            }
          }
        }
      }
    }
  }
}
